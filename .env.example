# Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview # or any other suitable model
GEMINI_SYSTEM_MESSAGE=You are a friendly and helpful AI voice assistant on a phone call. Keep your voice stable. Be concise and clear.
GEMINI_AUDIO_CHUNK_COUNT=20

# Server Configuration
SERVER_DOMAIN=your_fallback_domain
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Teler Configuration
TELER_API_KEY=your_teler_api_key

# Logging
LOG_LEVEL=INFO

# Ngrok Configuration
NGROK_AUTHTOKEN=your_ngrok_token

# Others
NODE_ENV=production